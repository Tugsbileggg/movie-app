# Энэ файлыг .env.local нэрээр хуулаад өөрийн утгаа оруулна:
#   cp .env.example .env.local
#
# TMDB "API Read Access Token" (v4 auth, "eyJ..." гэж эхэлдэг урт JWT).
# Авах: https://www.themoviedb.org/settings/api
# Анхаар: "API Key" (v3, 32 тэмдэгт) биш — "API Read Access Token"-ыг ашиглана.
NEXT_PUBLIC_TMDB_TOKEN=your_tmdb_api_read_access_token_here
